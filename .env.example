# ─────────────────────────────────────────────
#  AI Face Alert System — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ----- Camera -----
# Use an RTSP URL for IP/CCTV cameras, or "0" for the default webcam
RTSP_URL=rtsp://username:password@192.168.1.100:554/stream

# Set to "true" when running headless (Docker / server — no display window)
HEADLESS=false

# ----- Telegram Alerts -----
# Create a bot via @BotFather on Telegram and paste the token here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal or group Telegram chat ID (use @userinfobot to find it)
TELEGRAM_CHAT_ID=your_chat_id_here

# ----- Database -----
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost/ai_face_alert

# ----- AI Decision Engine (optional — LLM-powered mode) -----
# Required only if you enable brain/agent.py (GPT-4o-mini decision layer)
OPENAI_API_KEY=sk-...
